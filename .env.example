# Copy this to `.env` on your Oracle VM (never commit .env — it's gitignored).
# On GitHub Actions you don't use this file — you add the same names as
# repository Secrets instead (Settings -> Secrets and variables -> Actions).
#
# All of these are FREE tiers. Create the keys, paste them here. Leave any you
# don't use blank — the swarm just uses whichever are present and rotates them.

GEMINI_API_KEY=          # https://aistudio.google.com/apikey        (most generous free tier)
GROQ_API_KEY=            # https://console.groq.com/keys             (fast, free)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys                (uses ":free" models)

# Optional — Cloudflare Workers AI free tier:
CF_ACCOUNT_ID=
CF_API_TOKEN=

# VM only — enable the local small-model fallback (Ollama). Leave unset on
# GitHub Actions. Setting it "turns on" the ollama provider.
# OLLAMA_HOST=http://127.0.0.1:11434
